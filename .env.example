# Copy to .env (never commit). Generate a hash with: cd backend && uv run python -m app.main hash 'password'
SECRET_KEY=change-me-64-hex-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Production only:
DATABASE_URL=postgresql+asyncpg://zxb:DB_PASSWORD@127.0.0.1:5432/zxb
DB_PASSWORD=
UPLOAD_DIR=/home/core/shovin/zxb-data/uploads
ALLOWED_ORIGINS=https://zxb.shov.in
# Sign in to register (required). Redirect URIs to register with each provider:
#   https://zxb.shov.in/api/v1/auth/discord/callback   and   https://zxb.shov.in/api/v1/auth/google/callback
PUBLIC_URL=https://zxb.shov.in
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: AUTH_DEV=1 adds a fake "Dev login" button. Never set in production.
